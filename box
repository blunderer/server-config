# old_volume_dirs: service volume folders still sitting in a previous SRV_VOLUMES root.
old_volume_dirs() {
	local cur_vols b v gd suf
	cur_vols=$(realpath -m "$(get volumes_dir /home/volumes)")
	local -a vols=() found=() vol_files=()
	for f in "$REPO/services"/*/quadlet/* \
		"${SRV_STATE:-/srv/releases}"/*/*/quadlet/*.container; do
		[[ -f $f ]] && vol_files+=("$f")
	done
	if ((${#vol_files[@]} > 0)); then
		mapfile -t vols < <(sed -n 's|.*[$]{SRV_VOLUMES}/\([^:/[:space:],]*\).*|\1|p' \
			"${vol_files[@]}" 2>/dev/null | sort -u)
	fi
	while IFS= read -r b; do
		[[ -n $b ]] || continue
		b=$(realpath -m "$b")
		[[ $b != "$cur_vols" && -d $b ]] || continue
		for v in "${vols[@]}"; do
			if [[ $v == *@instance@* ]]; then
				while IFS= read -r gd; do
					[[ -d $gd && " ${found[*]} " != *" $gd "* ]] && found+=("$gd")
				done < <(compgen -G "$b/${v//@instance@/*}" || true)
			elif [[ $v =~ ^@([a-z0-9]+)_vol@$ ]]; then
				suf=${BASH_REMATCH[1]}
				while IFS= read -r gd; do
					[[ -d $gd && " ${found[*]} " != *" $gd "* ]] && found+=("$gd")
				done < <(compgen -G "$b/agy-$suf" || true; compgen -G "$b/agy-*-$suf" || true)
			elif [[ -d "$b/$v" && " ${found[*]} " != *" $b/$v "* ]]; then
				found+=("$b/$v")
			fi
		done
	done < <(
		for f in "${SRV_STATE:-/srv/releases}"/*/*/.env; do
			[[ -f $f ]] && sed -n 's/^SRV_VOLUMES=//p' "$f"
		done | sort -u
	)
	local leg
	for leg in "$(get jellyfin_overlay_dir /home/srv-jellyfin)" "$(get agy_share_dir /home/srv-agy)"; do
		leg=$(realpath -m "$leg")
		[[ $leg != "$cur_vols" && $leg != "$cur_vols"/* && -d $leg ]] || continue
		[[ " ${found[*]} " != *" $leg "* ]] && found+=("$leg")
	done
	echo "${found[*]}"
}


# same_filesystem A B: can B hold hard links to files in A? Same device
# number (a btrfs subvolume counts as a different one, which is right: hard
# links cannot cross subvolumes either).
same_filesystem() {
	[[ $(stat -c %d "$1") == "$(stat -c %d "$2")" ]]
}

# check_path PATH [SERVICE]: directories end with /.
check_path() {
	local p=$1 svc=${2:+ ($2)}
	if [[ $p == */ ]]; then
		[[ -d $p ]] && ok "$p$svc" || fail "missing folder $p$svc"
	else
		[[ -f $p ]] && ok "$p$svc" || fail "missing file $p$svc"
	fi
}

