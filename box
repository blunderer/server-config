# send_alert SUBJECT < body: one email to alert_email; never fails the caller.
send_alert() {
	local subject=$1 host
	host=$(hostname -s)
	if ! alerts_configured; then
		echo "alert (not sent, alert_email unset): $subject" >&2
		cat >/dev/null
		return 0
	fi
	{
		echo "To: $(get alert_email)"
		echo "From: box $host <$(get alert_from "alerts@blunderer.org")>"
		echo "Subject: [$host] $subject"
		echo "Date: $(date -R)"
		echo "Content-Type: text/plain; charset=UTF-8"
		echo
		# strip colours from captured output
		sed -E 's/\x1b\[[0-9;]*m//g'
		echo
		echo "-- "
		echo "box on $(get server_name) ($(hostname -f 2>/dev/null || hostname))"
	} | /usr/bin/msmtp -t 2>&1 | systemd-cat -t srv-alert ||
		echo "could not send the alert '$subject' (journalctl -t srv-alert)" >&2
	return 0
}


