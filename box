#!/usr/bin/env bash
# shellcheck disable=SC2015 # `test && ok || fail` reporting is intended
#
# box - set up, upgrade and check a host running srv.
#
#   box setup        everything, in order (idempotent: run it again any time)
#   box check        is this host ready? (folders, files, services, disk...)
#   box audit        what drifted (and which box command fixes it),
#                         plus the attack surface (ports, services, packages)
#
# Every file box manages is produced by a gen_* function below; the
# commands install that output and `audit` compares it with what is on disk.
#
# Host values come from the host env file (/etc/srv/host.env), read through
# `srv get`. Run as root. `box help` lists every command.

set -Eeuo pipefail

REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
SRV="$REPO/srv"
# own/mkdir_own: what box creates in the data folder belongs to its owner.
# shellcheck source=lib/data-owner.sh
. "$REPO/lib/data-owner.sh"
# runtime helpers: rootless Podman execution, user IDs, keep-id mapping.
# shellcheck source=lib/runtime.sh
. "$REPO/lib/runtime.sh"
export SRV_HOST_ENV=${SRV_HOST_ENV:-/etc/srv/host.env}

# Lazy loader for larger box libraries (lib/secrets.sh, lib/checks.sh,
# lib/tools.sh, lib/keys.sh, lib/peer_health.sh, lib/distdeb.sh).
declare -A _BOX_LOADED_LIBS=()
load_lib() {
	local name=$1
	[[ -z ${_BOX_LOADED_LIBS[$name]+set} ]] || return 0
	_BOX_LOADED_LIBS[$name]=1
	# shellcheck source=/dev/null
	. "$REPO/lib/$name.sh"
}

unix_role() { get unix_role; }
admin_role() { get admin_role "$(unix_role)"; }
runs() { [[ " $(get services) " == *" $1 "* ]]; }
alerts_pw_file() { echo "$(get data_dir /home/data)/keys/alerts/smtp_password"; }
alerts_account() {
	if alerts_configured; then get alert_smtp_user alerts; fi
}

# The whole package set srv needs. Nothing else is installed by this script,
# and recommends are disabled, to keep the attack surface small.
PKG_BASE=(ca-certificates curl git rsync cron initramfs-tools iproute2 openssh-server fail2ban python3-systemd
	systemd-timesyncd iptables msmtp tmux ncurses-term bind9-dnsutils vim openssh-client)
PKG_PODMAN=(podman crun catatonit aardvark-dns uidmap slirp4netns passt fuse-overlayfs dbus-user-session)
PKG_BASE+=(libpam-ssh-agent-auth)
# Certificate renewal needs nothing on the host: lego runs from its image
# (ssl/renew.sh).

if [[ -t 1 ]]; then
	C_RED=$'\e[31m' C_GRN=$'\e[32m' C_YLW=$'\e[33m' C_BLD=$'\e[1m' C_OFF=$'\e[0m'
else
	C_RED='' C_GRN='' C_YLW='' C_BLD='' C_OFF=''
fi
# -q (BOX_QUIET=1): no ok lines, and a section title only above a warning or
# failure of that section.
BOX_QUIET=${BOX_QUIET:-0} PENDING_SAY=''
say() {
	if [[ $BOX_QUIET == 1 ]]; then PENDING_SAY=$*; return; fi
	printf '%s==>%s %s\n' "$C_BLD" "$C_OFF" "$*"
}
flush_say() {
	[[ -n $PENDING_SAY ]] || return 0
	printf '%s==>%s %s\n' "$C_BLD" "$C_OFF" "$PENDING_SAY"
	PENDING_SAY=''
}
ok()   { [[ $BOX_QUIET == 1 ]] || printf '  %sok%s   %s\n' "$C_GRN" "$C_OFF" "$*"; }
warn() { flush_say; printf '  %swarn%s %s\n' "$C_YLW" "$C_OFF" "$*"; WARNINGS=$((WARNINGS + 1)); }
fail() { flush_say; printf '  %sFAIL%s %s\n' "$C_RED" "$C_OFF" "$*"; FAILURES=$((FAILURES + 1)); }
die()  { printf '%serror%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }
WARNINGS=0 FAILURES=0

need_root() { [[ $(id -u) == 0 ]] || die "run as root: sudo ${0##*/} ${BOX_ARGS:-}"; }
need_env() { [[ -e $SRV_HOST_ENV ]] || die "missing $SRV_HOST_ENV (see examples/example.env, docs/host-setup.md)"; }
get() { "$SRV" get "$@"; }
confirm() {
	local a
	[[ ${SRV_YES:-0} == 1 ]] && return 0
	[[ -t 0 ]] || return 1
	read -r -p "$1 [y/N] " a
	[[ $a == [yY]* ]]
}

# install_file SRC DEST [MODE]: copy if different, keep a .bak of the old file.
# Returns 0 when the file changed.
# Every file box installs is recorded in MANAGED_LIST (and its .bak copy is
# box's too): box distdeb leaves them out of what differs from Debian.
MANAGED_LIST=/var/lib/srv-host/managed-files
managed_add() {
	mkdir -p "$(dirname "$MANAGED_LIST")"
	grep -qxF "$1" "$MANAGED_LIST" 2>/dev/null || printf '%s\n' "$1" >>"$MANAGED_LIST"
}

install_file() {
	local src=$1 dest=$2 mode=${3:-0644}
	managed_add "$dest"
	if [[ -f $dest ]] && cmp -s "$src" "$dest"; then return 1; fi
	mkdir -p "$(dirname "$dest")"
	[[ -f $dest ]] && cp -a "$dest" "$dest.bak"
	install -m "$mode" "$src" "$dest"
	echo "  installed $dest"
}

# install_text DEST [MODE] < content
install_text() {
	local tmp rc=0
	tmp=$(mktemp)
	cat >"$tmp"
	install_file "$tmp" "$@" || rc=$?
	rm -f "$tmp"
	return $rc
}

renews_certificates() {
	local v
	v=$(get ssl_renew "")
	[[ $v == yes ]] && return 0
	[[ $v == no ]] && return 1
	[[ $(get is_leader no) == yes ]]   # default: the leader
}

# ---------------------------------------------------------------- generators
# Each prints the exact content of one managed file.

gen_apt_minimal() {
	cat <<-'EOF'
		// box: keep the package set minimal.
		APT::Install-Recommends "false";
		APT::Install-Suggests "false";
	EOF
}

ssh_password_auth() {
	local v
	v=$(get ssh_password_auth "")
	case $v in
		"" | no) echo no ;;
		yes) echo yes ;;
		*) die "ssh_password_auth=$v: expected yes or no" ;;
	esac
}

default_ssh_allow_users() {
	local adm
	adm=$(admin_role)
	if [[ $adm == root ]]; then
		echo root
	else
		echo "root $adm"
	fi
}

gen_sshd_dropin() {
	local p allow pw
	allow=$(get ssh_allow_users "$(default_ssh_allow_users)") || return 1
	pw=$(ssh_password_auth) || return 1
	echo "# Generated by box ssh (host/ssh/srv.conf + host values)."
	for p in $(ssh_ports); do echo "Port $p"; done
	cat "$REPO/host/ssh/srv.conf"
	echo "PasswordAuthentication $pw"
	[[ -n $allow ]] && echo "AllowUsers $allow"
	return 0
}

gen_fail2ban_ssh() {
	cat <<-EOF
		# Generated by box: sshd port(s) from the host env file.
		[sshd]
		port = $(ssh_ports | tr ' ' ',')
	EOF
}

gen_cron() {
	local services data
	services=" $(get services) "
	data=$(get data_dir /home/data)
	# `box run NAME CMD`: output to the journal (journalctl -t srv-NAME),
	# and an alert email when CMD fails.
	echo "# Generated by box cron: edit box, not this file."
	echo "SHELL=/bin/bash"
	echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
	echo "MAILTO=\"\""
	echo
	echo "# Package upgrades (daily)"
	echo "0 1 * * * root box run upgrade box upgrade"
	if [[ $services == *" db "* ]]; then
		echo "# Consistent database dump (daily)"
		echo "30 2 * * * root box run db-dump srv hook db dump"
	fi
	if [[ $services == *" agy "* ]]; then
		echo "# Folders shared with the agents (overlays): mount them again after a reboot"
		echo "@reboot root box run agy-shares srv hook agy share"
	fi
	if [[ $services == *" jellyfin "* ]]; then
		echo "# Writable overlay over the downloads folder: mount it again after a reboot"
		echo "@reboot root box run jellyfin-overlay srv hook jellyfin mount"
	fi
	if [[ $services == *" mail "* ]]; then
		echo "# DMARC reports kept here: delete those older than 90 days (daily)"
		echo "45 2 * * * root box run mail-reports srv hook mail prune-reports"
	fi
	if [[ -n $(get remote_hosts "") ]]; then
		echo "# Replicate the data folder to the other hosts (daily)"
		echo "0 3 * * * root box run data-push $REPO/backup/data-sync.sh push"
	fi
	echo "# Local incremental backup (daily)"
	echo "0 4 * * * root box run backup $REPO/backup/diff-backup.sh $data $(get backup_dir /home/backup)"
	if [[ -n $(get smtp "") && $services == *" dns "* ]]; then
		echo "# smtp.blunderer.org in this host's BIND: only the mail hosts that work (every 5 minutes)"
		echo "*/5 * * * * root box run smtp-health box smtp-health"
	fi
	if [[ $(get in_inventory yes) == yes && -n $(peers) ]]; then
		echo "# The other hosts' services, from outside; alerts on a change (every 15 minutes)"
		echo "*/15 * * * * root box run peer-health box peer-health"
	fi
	if renews_certificates; then
		echo "# Let's Encrypt (daily; lego renews only when due)"
		echo "0 5 * * * root box run ssl-renew $REPO/ssl/renew.sh"
	fi
	echo "# Pick up renewed certificates (daily, every host)"
	echo "0 6 * * * root box run reload srv reload web mail"
	echo "# Health: alert on failures (daily), full report (weekly, Monday)"
	echo "0 7 * * * root box watch"
	echo "30 7 * * 1 root box report"
}

# msmtp sends the alerts through the mail service, authenticated as a
# dedicated account (docs/host-setup.md, "Email alerts").
gen_msmtprc() {
	local data
	data=$(get data_dir /home/data)
	cat <<-EOF
		# Generated by box alerts.
		defaults
		auth on
		tls on
		tls_trust_file /etc/ssl/certs/ca-certificates.crt
		syslog LOG_MAIL
		aliases /etc/aliases.msmtp

		account alerts
		host $(get alert_smtp_host "$(get mail_relay)")
