# host_ip NAME: address of a host of the inventory.
host_ip() {
	local name=$1
	[[ " $(get hosts) " == *" $name "* ]] || die "unknown host '$name' (hosts: $(get hosts))"
	get "${name}_ip"
}

# set_inventory KEY VALUE: in the inventory (hosts.env), keeping a dated copy
# of the previous version.
set_inventory() {
	local file
	file=$(get hosts_file)
	set_inventory_in "$file" "$@"
}

# set_inventory_in FILE KEY VALUE [KEY VALUE...]: several changes at once,
# without reading the inventory in between.
set_inventory_in() {
	local file=$1 key value backup
	shift
	backup="$file.$(date +%Y%m%d-%H%M%S)"
	cp -a "$file" "$backup"
	while [[ $# -ge 2 ]]; do
		key=$1 value=$2
		shift 2
		if grep -qE "^$key=" "$file"; then
			sed -i -E "s|^$key=.*|$key=$value|" "$file"
		else
			echo "$key=$value" >>"$file"
		fi
	done
	chown --reference="$backup" "$file"
	chmod --reference="$backup" "$file"
}


# ------------------------------------------------------------- smtp-health
#
# smtp.blunderer.org is the name mail clients send through (Gmail's "Send
# mail as"). It has one address per mail host listed in smtp= (inventory) that
# works like Gmail needs it (STARTTLS with a certificate for the name, then a
# login with the alerts account); box smtp-health (cron, every 5 minutes, on
# every name server) removes a host that stops working and adds it back when
# it works again, through a signed DNS update of this host's own copy of the
# zone (each name server is its primary; TTL 60 s). A dead host, the leader
# included, drops out of every surviving name server's copy. It never empties
# the record: with every host down, it keeps them all.

SMTP_ZONE=smtp.blunderer.org
smtp_key() { echo "$(get data_dir /home/data)/keys/dns/smtp-tsig.key"; }

# smtp_works ADDRESS: what Gmail does with it. With the alerts account
# (alerts set up on this host): STARTTLS on 587 with a certificate valid for
# smtp.blunderer.org, then a login (lib/smtp_login.py). Without it, only an
# SMTP greeting on 587. Prints the failed step.
# shellcheck disable=SC2016 # expanded by the inner bash
smtp_works() {
	local user pw
	user=$(alerts_account)
	pw=$(alerts_pw_file)
	if [[ -n $user && -s $pw ]]; then
		python3 "$REPO/lib/smtp_login.py" "$1" "$SMTP_ZONE" "$user" "$pw"
	else
		timeout 10 bash -c 'exec 3<>"/dev/tcp/$1/587" && read -r -t 8 line <&3 && [[ $line == 220* ]]' _ "$1" 2>/dev/null ||
			{ echo "no SMTP greeting on 587"; return 1; }
	fi
}

# smtp_healthy_hosts: the hosts of smtp= that work (two tries 5 s apart, so one
# dropped connection is not an outage). Why the others failed goes to
# $STATE_DIR/smtp-health.why.
smtp_healthy_hosts() {
	local h ip why
	mkdir -p "$STATE_DIR"
	: >"$STATE_DIR/smtp-health.why"
	for h in $(get smtp ""); do
		ip=$(get "${h}_ip")
		if why=$(smtp_works "$ip") || { sleep 5 && why=$(smtp_works "$ip"); }; then
			echo "$h"
		else
			echo "$h ($ip): $why" | tee -a "$STATE_DIR/smtp-health.why" >&2
		fi
	done
}

smtp_records_for() { # smtp_records_for HOST...: sorted "TYPE ADDRESS" lines
	local h ip6
	for h in "$@"; do
		echo "A $(get "${h}_ip")"
		ip6=$(get "${h}_ip6" "")
		[[ -z $ip6 ]] || echo "AAAA $ip6"
	done | sort
}

# What this host's BIND serves now, as "TYPE ADDRESS" lines.
smtp_served() {
	{
		{ dig +short +norecurse @127.0.0.1 "$SMTP_ZONE" A || true; } | sed 's/^/A /'
		{ dig +short +norecurse @127.0.0.1 "$SMTP_ZONE" AAAA || true; } | sed 's/^/AAAA /'
	} | { grep -E '^(A|AAAA) [0-9a-fA-F:.]+$' || true; } | sort
}


# smtp_alerter HEALTHY...: whether this host sends the alerts, so that one
# outage gives one mail, not one per name server. The leader does, unless it
# is a mail host found down; then the first working host of smtp= does (a
# mail host normally runs dns too, so it has this job).
smtp_alerter() {
	local leader self h
	leader=$(get leader)
	self=$(get host)
	# No working host at all (then no mail goes out anyway): the leader tries.
	if (($# == 0)) || [[ " $(get smtp "") " != *" $leader "* || " $* " == *" $leader "* ]]; then
		[[ $self == "$leader" ]]
		return
	fi
	for h in $(get smtp ""); do
		[[ " $* " == *" $h "* ]] && { [[ $h == "$self" ]]; return; }
	done
	return 1
}

# smtp_health_alert DOWN UP: one alert per change of the set of hosts not
# answering, not one every 5 minutes.
smtp_health_alert() {
	local gone=$1 up=$2 state=$STATE_DIR/smtp-health
	mkdir -p "$STATE_DIR"
	[[ "$(cat "$state" 2>/dev/null)" != "$gone" ]] || return 0
	printf '%s\n' "$gone" >"$state"
	if [[ -z $gone ]]; then
		echo "Every mail host works again: $SMTP_ZONE is $up." | send_alert "smtp: all hosts back"
	elif [[ -z $up ]]; then
		{ echo "No mail host works ($gone): $SMTP_ZONE keeps them all."; echo; cat "$STATE_DIR/smtp-health.why"; } |
			send_alert "smtp: no host works"
	else
		{ echo "Removed from $SMTP_ZONE: $gone. Still in: $up."; echo; cat "$STATE_DIR/smtp-health.why"; } |
			send_alert "smtp: $gone removed"
	fi
}

# check_smtp_name: which hosts of smtp= this host's copy of the name leaves
# out now.
check_smtp_name() {
	local served h out=() ip
	served=$(smtp_served)
	if [[ -z $served ]]; then
		fail "$SMTP_ZONE has no address (srv deploy dns, then box smtp-health)"
		return 0
	fi
	for h in $(get smtp ""); do
		ip=$(get "${h}_ip")
		grep -qxF "A $ip" <<<"$served" || out+=("$h")
	done
	if ((${#out[@]})); then
		warn "$SMTP_ZONE leaves out ${out[*]}: $(xargs <"$STATE_DIR/smtp-health.why" 2>/dev/null)"
	else
		ok "$SMTP_ZONE: every host listed in smtp= ($(get smtp ""))"
	fi
}

need_leader() {
	[[ $(get is_leader no) == yes ]] ||
		die "run this on the leader ($(get leader)); this host is $(get host)"
	"$SRV" status dns 2>/dev/null | awk 'NR==2 && $2 ~ /^[0-9]/ {f=1} END {exit !f}' ||
		die "the dns service is not deployed with srv on this host"
}


newest_dump() {
	local d
	d=$(find "$(get data_dir /home/data)/backups/mariadb" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | tail -1)
	echo "${d:-none}"
}


get_site_name() { echo blunderer.org; }

# wait_for_slaves IP: every slave (dns_slaves) serves the new address, after
# the master's NOTIFY. Queried with dig inside the dns container.
wait_for_slaves() {
	local want=$1 ns got serial deadline=$((SECONDS + 120)) pending
	local -a slaves
	read -ra slaves <<<"$(get dns_slaves "")"
	serial=$("$SRV" exec dns bind dig +short @127.0.0.1 "$(get_site_name)" SOA 2>/dev/null | awk '{print $3}')
	echo "   master: $(get_site_name) -> $("$SRV" exec dns bind dig +short @127.0.0.1 "$(get_site_name)" A 2>/dev/null) (serial $serial)"
	while :; do
		pending=0
		for ns in "${slaves[@]}"; do
			got=$("$SRV" exec dns bind dig +short +time=2 +tries=1 @"$ns" "$(get_site_name)" A 2>/dev/null | head -1)
			[[ $got == "$want" ]] || pending=1
		done
		[[ $pending == 0 || $SECONDS -ge $deadline ]] && break
		sleep 5
	done
	for ns in "${slaves[@]}"; do
		got=$("$SRV" exec dns bind dig +short +time=2 +tries=1 @"$ns" "$(get_site_name)" A 2>/dev/null | head -1)
		if [[ $got == "$want" ]]; then
			ok "slave $ns serves $want"
		else
			warn "slave $ns still serves ${got:-nothing} (check its transfer: srv logs dns there)"
		fi
	done
}

# --------------------------------------------------------------------- audit

# differs DEST GENERATOR: the file on disk is not what the generator produces.
differs() {
	local dest=$1
	shift
	! cmp -s "$dest" <("$@" 2>/dev/null) 2>/dev/null
}
pkg_missing() { [[ $(dpkg-query -W -f='${Status}' "$1" 2>/dev/null) != "install ok installed" ]]; }

# audit_drift: one line per difference between this host and what the
# repository + host env file describe, each with the box command that
# fixes it, then a summary line. Prints nothing when everything matches.
audit_drift() {
	local -a lines=() fixes=()
	add() { lines+=("  $1"$'\n'"      -> box $2"); [[ " ${fixes[*]} " == *" $2 "* ]] || fixes+=("$2"); }
	note() { lines+=("  $1"); }
	local p missing=() port

	# hostname
	[[ $(hostname) == "$(gen_hostname)" && $(cat /etc/hostname 2>/dev/null) == "$(gen_hostname)" ]] ||
		add "hostname is $(hostname), the inventory says $(gen_hostname)" hostname
	differs /etc/hosts gen_hosts && add "/etc/hosts differs from the inventory" hostname
	[[ -d /etc/cloud ]] && differs /etc/cloud/cloud.cfg.d/99-srv.cfg gen_cloud_cfg &&
		add "cloud-init may reset the hostname and /etc/hosts at boot" hostname

	# man
	if [[ -n $(man_wanted) && $(man_wanted) != "$(cat "$MAN_STATE" 2>/dev/null)" ]]; then
		add "the containers' man pages do not match this host's services" man
	fi

	# ipv6
	if [[ -n $(get "$(get host)_ip6" "") && -n $(get ip6_gw "") ]] && differs "$IPV6_UNIT" gen_ipv6_unit; then
		add "$IPV6_UNIT differs from the host files (ip6_gw, ip6_intf)" ipv6
	fi

	# resolver
	if resolved_installed && ! resolved_masked; then
		add "systemd-resolved is not masked: it comes back at boot and takes port 53" resolver
	fi
	resolv_managed || add "/etc/resolv.conf is not box's (a link to resolved's, or rewritten by DHCP)" resolver
	[[ " $(get services) " == *" dns "* && -n $(port_53_users) ]] &&
		note "port 53 is used by: $(port_53_users | xargs) (the dns service needs it)"

	# packages
	for p in "${PKG_BASE[@]}" "${PKG_PODMAN[@]}"; do pkg_missing "$p" && missing+=("$p"); done
	[[ ${#missing[@]} -gt 0 ]] && add "missing packages: ${missing[*]}" packages
	differs /etc/apt/apt.conf.d/99srv-minimal gen_apt_minimal && add "apt still installs recommended packages" packages
	differs /etc/tmux.conf cat "$REPO/host/tmux/tmux.conf" && add "/etc/tmux.conf differs (tmux prefix, terminal)" packages
	differs /etc/gitconfig cat "$REPO/host/git/gitconfig" && add "/etc/gitconfig differs (git editor and identity)" packages
	differs /etc/vim/vimrc.local cat "$REPO/host/vim/vimrc.local" && add "/etc/vim/vimrc.local differs (vim mouse)" packages
	local su sh sf
	while read -r su sh; do
		for sf in "${SHELL_FILES[@]}"; do
			differs "$sh/.$sf" cat "$REPO/host/shell/$sf" && add "$su: ~/.$sf differs from host/shell" shell
		done
	done < <(shell_users)
	if [[ -d /etc/sudoers.d ]] && differs /etc/sudoers.d/srv-admin cat "$REPO/host/sudo/srv-admin"; then
		add "/etc/sudoers.d/srv-admin differs (session-scoped sudo cache)" shell
	fi
	if ! pkg_missing libpam-ssh-agent-auth && [[ -f /etc/pam.d/sudo ]] &&
		! grep -qE "^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_ssh_agent_auth\.so[[:space:]]+file=$SUDO_AUTH_KEYS([[:space:]]|\$)" /etc/pam.d/sudo; then
		add "/etc/pam.d/sudo missing pam_ssh_agent_auth" shell
	fi
	[[ $(readlink -f /usr/local/bin/srv 2>/dev/null) == "$(readlink -f "$SRV")" &&
		$(readlink -f /usr/local/bin/box 2>/dev/null) == "$(readlink -f "$REPO/box")" &&
		$(readlink -f /usr/local/bin/remote 2>/dev/null) == "$(readlink -f "$REPO/remote")" ]] ||
		add "srv/box/remote in /usr/local/bin do not point to this checkout" link

	# podman
	local pu puid p_home p_udir p_drift ovols
	pu=$(unix_role)
	differs /etc/sysctl.d/99-srv-podman.conf gen_podman_sysctl && add "Podman sysctl rules differ" podman
	differs /etc/modules-load.d/srv-podman.conf gen_podman_modules && add "Podman kernel module list differs" podman
	differs /etc/systemd/journald.conf.d/srv.conf cat "$REPO/host/journald/srv.conf" &&
		add "journald size cap not installed" podman
	differs /etc/containers/containers.conf.d/srv.conf gen_podman_containers_conf &&
		add "/etc/containers/containers.conf.d/srv.conf differs" podman
	if id "$pu" >/dev/null 2>&1; then
		puid=$(id -u "$pu")
		p_home=$(getent passwd "$pu" | cut -d: -f6)
		p_udir="$p_home/.config/containers/systemd"
		_subid_ok /etc/subuid "$pu" "$puid" && _subid_ok /etc/subgid "$pu" "$puid" ||
			add "subuid/subgid missing or <65536 for $pu" podman
		[[ $(loginctl show-user "$pu" -p Linger --value 2>/dev/null || true) == yes ]] ||
			add "systemd linger not enabled for $pu" podman
		differs "$p_home/.config/containers/storage.conf" gen_podman_storage_conf &&
			add "$p_home/.config/containers/storage.conf differs (graphroot)" podman
		if [[ -n $(get services "") ]]; then
			for net in $("$SRV" networks); do
				[[ -f "$p_udir/$net.network" ]] || add "quadlet network $p_udir/$net.network missing" podman
			done
		fi
		load_lib secrets
		p_drift=$(keys_podman_drift)
		[[ -n $p_drift ]] && note "Podman secrets out of sync with $(get data_dir /home/data)/keys -> box keys sync --restart"
	else
		add "unix_role user '$pu' does not exist" podman
	fi
	[[ -n $(get services "") && ! -d $(get volumes_dir /home/volumes) ]] &&
		add "volumes folder $(get volumes_dir /home/volumes) missing" podman
	[[ " $(get services '') " == *" autoheal "* ]] &&
		note "remove retired 'autoheal' from services= in $SRV_HOST_ENV"
	[[ -d ${SRV_STATE:-/srv/releases}/autoheal ]] &&
		note "retired autoheal release state present (box docker-remove cleans it up)"
	ovols=$(old_volume_dirs)
	[[ -n $ovols ]] && note "previous volume folder(s) still present ($ovols): srv deploy + srv commit moves them to $(get volumes_dir /home/volumes)"

	local data_d backup_d rel p
	data_d=$(get data_dir /home/data)
	backup_d=$(get backup_dir /home/backup)
	for rel in "${PROTECTED_SECRET_DIRS[@]}"; do
		p="$data_d/$rel"
		[[ -d $p ]] || continue
		if [[ $(stat -c '%u:%g' "$p") != 0:0 ]] || (( (8#$(stat -c %a "$p") & 8#077) != 0 )); then
			add "$p is not protected (expected root:root 0700)" podman
		fi
	done
	if [[ -d $backup_d ]]; then
		if [[ $(stat -c '%u:%g' "$backup_d") != 0:0 ]] || (( (8#$(stat -c %a "$backup_d") & 8#077) != 0 )); then
			add "$backup_d is not protected (expected root:root 0700)" cron
		fi
	fi

	# ssh
	port=$(get ssh_port 222)
	differs /etc/ssh/sshd_config.d/srv.conf gen_sshd_dropin && add "sshd drop-in differs (ports, hardening, AllowUsers)" ssh
	local actual_pw want_pw
	want_pw=$(ssh_password_auth) || return 1
	actual_pw=$(sshd -T 2>/dev/null | awk '$1 == "passwordauthentication" {print $2}')
	[[ -z $actual_pw || $actual_pw == "$want_pw" ]] ||
		add "sshd effective PasswordAuthentication ($actual_pw) differs from $want_pw" ssh
	differs /etc/ssh/ssh_config.d/srv.conf gen_ssh_client && add "ssh client settings for the other hosts differ (inventory, ports)" ssh-keys
	local auth
	auth=$(authorized_keys_file)
	differs "$auth" gen_authorized_keys "$auth" && add "$auth: the other hosts' keys differ (inventory or keys changed)" ssh-keys
	cmp -s "$(host_key "$(get host)")" "/root/.ssh/id_ecdsa_$(get host)" || add "this host's ssh key is not installed in /root/.ssh" ssh-keys
	if [[ $(get in_inventory yes) == yes ]]; then
		differs /root/.ssh/authorized_keys gen_root_authorized_keys && add "/root/.ssh/authorized_keys differs (peer sync keys)" ssh-keys
		differs "$SUDO_AUTH_KEYS" gen_sudo_authorized_keys && add "$SUDO_AUTH_KEYS differs (sudo ssh-agent keys)" ssh-keys
		cmp -s "$REPO/host/ssh/srv-sync-endpoint" "$SRV_SYNC_ENDPOINT" 2>/dev/null || add "$SRV_SYNC_ENDPOINT missing or outdated" ssh-keys
		differs "$SRV_SYNC_CONF" gen_sync_endpoint_conf && add "$SRV_SYNC_CONF missing or differs" ssh-keys
	fi
	grep -qE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/' /etc/ssh/sshd_config 2>/dev/null ||
		add "sshd_config does not include sshd_config.d (the drop-in is ignored)" ssh
	grep -qE '^[[:space:]]*Port[[:space:]]' /etc/ssh/sshd_config 2>/dev/null &&
		add "sshd_config still sets Port itself" ssh
	systemctl is-enabled ssh.socket >/dev/null 2>&1 && add "ssh socket activation is on (it ignores the port)" ssh
	local want have
	want=$(ssh_ports | tr ' ' '\n' | sort -n | xargs)
	have=$(ss -Htlnp 2>/dev/null | grep -E '"sshd' | awk '{print $4}' | grep -oE '[0-9]+$' | sort -un | xargs)
	if [[ -z $have ]]; then
		add "sshd is not listening" ssh
	elif [[ $have != "$want" ]]; then
		add "sshd listens on [$have], expected [$want]" ssh
	elif [[ $want == "22 $port" ]]; then
		note "port 22 is still open next to $port: check 'ssh -p $port' from another terminal (and the provider firewall),"
		note "      then -> box ssh-confirm"
		[[ " ${fixes[*]} " == *" ssh-confirm "* ]] || fixes+=("ssh-confirm")
	fi

	# fail2ban
	differs /etc/fail2ban/jail.local cat "$REPO/host/fail2ban/jail.local" && add "fail2ban jails differ" fail2ban
	differs /etc/fail2ban/filter.d/srv-postfix-sasl.conf cat "$REPO/host/fail2ban/filter.d/srv-postfix-sasl.conf" &&
		add "fail2ban SMTP AUTH filter differs" fail2ban
	if [[ -e /etc/fail2ban/jail.d/srv-docker.local ]]; then
		add "obsolete /etc/fail2ban/jail.d/srv-docker.local present" fail2ban
	fi
	differs /etc/fail2ban/jail.d/srv-sshd.local gen_fail2ban_ssh && add "fail2ban watches the wrong ssh port(s)" fail2ban
	systemctl is-active -q fail2ban 2>/dev/null || add "fail2ban is not running" fail2ban

	# cron
	differs /etc/cron.d/srv gen_cron && add "/etc/cron.d/srv differs (services, the inventory or the repository changed)" cron

	# alerts
	if alerts_configured; then
		differs /etc/msmtprc gen_msmtprc && add "alert mail settings differ" alerts
		differs /etc/aliases.msmtp gen_msmtp_aliases && add "alert recipient differs" alerts
		[[ -s "$(get data_dir /home/data)/keys/alerts/smtp_password" ]] ||
			note "no SMTP password for alerts: run box alerts-account on the leader"
	else
		note "alert_email is not set: failures are not emailed (examples/example.env)"
	fi

	# services: the deployed release no longer matches what the repository and
	# the host values (inventory included) render today.
	local svc cur tmp deploys=()
	for svc in $("$SRV" services 2>/dev/null | awk '{print $1}'); do
		cur=$(readlink "${SRV_STATE:-/srv/releases}/$svc/current" 2>/dev/null) || continue
		tmp=$(mktemp -d)
		if "$SRV" render "$svc" "$tmp/r" >/dev/null 2>&1 &&
			! releases_match "${SRV_STATE:-/srv/releases}/$svc/$cur" "$tmp/r"; then
			lines+=("  $svc: release $cur differs from what the repository and host values give now"$'\n'"      -> srv deploy $svc")
			deploys+=("$svc")
		fi
		rm -rf "$tmp"
	done

	[[ ${#lines[@]} -gt 0 ]] || return 0
	printf '%s\n' "${lines[@]}"
	[[ ${#deploys[@]} -gt 0 ]] && printf '\n  Deploy: srv deploy %s   (one at a time, then srv commit)\n' "${deploys[*]}"
	if [[ ${#fixes[@]} -gt 0 ]]; then
		# In setup order; ssh-confirm last (after testing the new port).
		local ordered=() c
		for c in link hostname ipv6 resolver packages shell man podman ssh-keys ssh fail2ban alerts cron ssh-confirm; do
			[[ " ${fixes[*]} " == *" $c "* ]] && ordered+=("$c")
		done
		printf '\n  Run: box %s\n' "${ordered[*]}"
	fi
	return 0
}

# releases_match DIR_CUR DIR_NEW: 0 if rendered config matches after normalizing
# release timestamps and release directory paths.
releases_match() {
	local dcur=$1 dnew=$2 rcur rnew pcur pnew norm rc=1
	rcur=$(sed -n 's/^SRV_RELEASE=//p' "$dcur/.env" 2>/dev/null | head -n 1)
	rnew=$(sed -n 's/^SRV_RELEASE=//p' "$dnew/.env" 2>/dev/null | head -n 1)
	rcur=${rcur:-${dcur##*/}}
	rnew=${rnew:-${dnew##*/}}
	pcur=$(realpath -m "$dcur")
	pnew=$(realpath -m "$dnew")
	norm=$(mktemp -d)
	cp -a "$dcur" "$norm/a"
	cp -a "$dnew" "$norm/b"
	rm -f "$norm/a/release.info" "$norm/b/release.info"
	find "$norm/a" -type f -exec sed -i \
		-e "s|$pcur|<RELEASE_DIR>|g" \
		-e "s|$dcur|<RELEASE_DIR>|g" \
		-e "s|^SRV_RELEASE=.*|SRV_RELEASE=<REL>|" \
		-e "s|:${rcur}\([[:space:]]*\\)\$|:<REL>\\1|" {} +
	find "$norm/b" -type f -exec sed -i \
		-e "s|$pnew|<RELEASE_DIR>|g" \
		-e "s|$dnew|<RELEASE_DIR>|g" \
		-e "s|^SRV_RELEASE=.*|SRV_RELEASE=<REL>|" \
		-e "s|:${rnew}\([[:space:]]*\\)\$|:<REL>\\1|" {} +
	if diff -rq -I '^SRV_RELEASE=' -I '; Serial$' "$norm/a" "$norm/b" >/dev/null 2>&1; then
		rc=0
	fi
	rm -rf "$norm"
	return "$rc"
}


# --------------------------------------------------------------------- setup

# ------------------------------------------------------------------- main

load_cmd() {
	local f="$REPO/cmd/box/$1.sh"
	[[ -f $f ]] || die "unknown command '$1' (box help)"
	# shellcheck source=/dev/null
	. "$f"
}

run_cmd() {
	local c=$1
	shift
	[[ $c =~ ^[a-z0-9-]+$ ]] || die "unknown command '$c' (box help)"
	load_cmd "$c"
	"cmd_${c//-/_}" "$@"
}

main() {
	# -q / --quiet, anywhere: only warnings and failures (box check -q).
	local a args=()
	for a in "$@"; do
		case $a in
			-q | --quiet) BOX_QUIET=1 ;;
			*) args+=("$a") ;;
		esac
	done
	set -- "${args[@]}"
	[[ $# -gt 0 ]] || set -- help
	BOX_ARGS="$*"
	case $1 in
		# commands taking arguments
		run | backups | data | mail | dns | tls | ban | minecraft | 		ssl-renew | keys | distdeb | migrate | leader | alert | 		ssh-trusted | check | apply-role-change | login)
			local c=$1
			shift
			run_cmd "$c" "$@"
			return
			;;
		smtp-health | peer-health)
			run_cmd "$1"
			return
			;;
		link | unlink)
			[[ ${2:-} == /* ]] && { run_cmd "$1" "$2"; return; }
			;;
	esac
	local cmd
	for cmd in "$@"; do
		case $cmd in
			help | -h | --help) run_cmd help ;;
			link | unlink) run_cmd "$cmd" "" ;;
			*) run_cmd "$cmd" ;;
		esac
	done
}

main "$@"
