write_fail2ban_ssh() {
	gen_fail2ban_ssh | install_text /etc/fail2ban/jail.d/srv-sshd.local
}

# ------------------------------------------------------------- ssh-trusted

# Addresses fail2ban never bans (this host's own state, not in git: your home
# and office addresses). box fail2ban leaves this file alone.
TRUSTED_FILE=/etc/fail2ban/jail.d/srv-trusted.local

# client_ip: the address of the ssh session running this command, or nothing.
# sudo drops SSH_CONNECTION; `who -m` reads it from the terminal's login entry.
client_ip() {
	local ip=${SSH_CONNECTION:-}
	ip=${ip%% *}
	if [[ -z $ip ]]; then
		ip=$(who -m 2>/dev/null | sed -n 's/.*(\([^)]*\)).*/\1/p' | head -n 1)
	fi
	if valid_ip "$ip"; then echo "$ip"; fi
}

# valid_ip ADDR: an IPv4/IPv6 address or network (CIDR).
valid_ip() {
	[[ -n ${1:-} ]] && python3 -c 'import ipaddress, sys; ipaddress.ip_network(sys.argv[1], strict=False)' "$1" 2>/dev/null
}

# The hosts of the inventory, never banned either: they log in to each other
# (replication) and box smtp-health logs in to every mail host every 5
# minutes from every name server, so a wrong password there must not ban one.
inventory_ips() {
	local h
	for h in $(get hosts ""); do
		get "${h}_ip" ""
		get "${h}_ip6" ""
	done | sed '/^$/d' | sort -u
}

# Your trusted addresses: the ignoreip list minus loopback and the inventory.
trusted_ips() {
	[[ -f $TRUSTED_FILE ]] || return 0
	sed -n 's/^ignoreip[[:space:]]*=[[:space:]]*//p' "$TRUSTED_FILE" | tr ' ' '\n' |
		grep -vxE '127\.0\.0\.1/8|::1|' | grep -vxF -f <(inventory_ips; echo 127.0.0.1/8) || true
}

write_trusted() { # write_trusted ADDR...
	mkdir -p "$(dirname "$TRUSTED_FILE")"
	{
		echo "# Managed by box: addresses fail2ban never bans (the inventory's"
		echo "# hosts, and yours from box ssh-trusted)."
		echo "[DEFAULT]"
		echo "ignoreip = 127.0.0.1/8 ::1 $(inventory_ips | xargs)${*:+ $*}"
	} >"$TRUSTED_FILE"
	if systemctl is-active -q fail2ban 2>/dev/null; then
		fail2ban-client reload >/dev/null
	fi
}


