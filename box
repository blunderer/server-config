# ----------------------------------------------------------------------- ssh

SSH_CONFIRMED=/etc/ssh/srv-port-confirmed

# ssh_ports: ports sshd should listen on. While moving off 22, both stay open
# until `box ssh-confirm` (so a mistake cannot lock you out).
ssh_ports() {
	local port
	port=$(get ssh_port 222)
	if [[ $port != 22 && $(cat "$SSH_CONFIRMED" 2>/dev/null) != "$port" ]]; then
		echo "22 $port"
	else
		echo "$port"
	fi
}


# ------------------------------------------------------------------ ssh-keys
#
# One key pair per host, for the hosts to reach each other (replication,
# certificates, inventory, takeover): <data>/keys/ssh/id_ecdsa_<host>(.pub).
# They live in the data folder, created on the leader for every host of the
# inventory and replicated from there (a key created elsewhere would be
# deleted by the next replication). Each host installs its own pair in the
# ~/.ssh of root (cron jobs) and of unix_role, and authorizes the
# others' public keys for unix_role. Root never logs in over ssh.

ssh_dir() { echo "$(get data_dir /home/data)/keys/ssh"; }
host_key() { echo "$(ssh_dir)/id_ecdsa_$1"; } # host_key HOST: root-only sync key (or client key off-inventory)

SRV_SYNC_ENDPOINT=/usr/local/libexec/srv-sync-endpoint
SRV_SYNC_CONF=/etc/srv/sync-endpoint.conf
SUDO_AUTH_KEYS=/etc/ssh/sudo_authorized_keys
gen_sync_endpoint_conf() { printf 'DATA_DIR=%s\n' "$(get data_dir /home/data)"; }

# ssh port of host H: <H>_ssh_port (inventory, or ssh_port in configs/<H>.env), else this host's ssh_port.
peer_ssh_port() { get "$1_ssh_port" "$(get ssh_port 222)"; }

# The other hosts of the inventory.
peers() {
	local h self
	self=$(get host)
	for h in $(get hosts); do
		[[ $h == "$self" ]] || echo "$h"
	done
}

# Accounts that get this host's key in their ~/.ssh:
# - On inventory servers: root ONLY (used exclusively for forced-command rsync;
#   admin_role uses ssh -A or `box loadssh` with a personal/laptop key).
# - Outside the inventory (a laptop): root, admin_role, and SUDO_USER.
key_accounts() {
	local user
	user=$(admin_role)
	echo root
	if [[ $(get in_inventory yes) == no ]]; then
		if [[ $user != root ]] && getent passwd "$user" >/dev/null; then echo "$user"; fi
		if [[ -n ${SUDO_USER:-} && $SUDO_USER != root && $SUDO_USER != "$user" ]]; then
			echo "$SUDO_USER"
		fi
	fi
}

account_home() { getent passwd "$1" | cut -d: -f6; }

gen_ssh_client() {
	local h ip ip6 dom self user has_key=no in_inv patterns=() pat
	self=$(get host) user=$(admin_role) dom=$(get domain blunderer.org)
	in_inv=$(get in_inventory yes)
	[[ -s $(host_key "$self") ]] && has_key=yes
	echo "# Generated by box ssh-keys: how this host reaches the others."
	if [[ $in_inv == yes ]]; then
		for h in $(peers); do
			ip=$(get "${h}_ip")
			ip6=$(get "${h}_ip6" "")
			patterns+=("$h" "$h.$dom" "$ip")
			[[ -n $ip6 ]] && patterns+=("$ip6")
		done
		if ((${#patterns[@]} > 0)); then
			pat=$(IFS=,; echo "${patterns[*]}")
			echo
			echo "Match localuser root host $pat"
			echo "	User root"
			if [[ $has_key == yes ]]; then
				echo "	IdentityFile /root/.ssh/id_ecdsa_$self"
				echo "	IdentitiesOnly yes"
			fi
		fi
	fi
	for h in $(peers); do
		ip6=$(get "${h}_ip6" "")
		echo
		echo "Host $h $h.$dom $(get "${h}_ip")${ip6:+ $ip6}"
		echo "	Port $(peer_ssh_port "$h")"
		echo "	User $user"
		if [[ $in_inv == no ]]; then
			# On a laptop, forward ssh-agent so pam_ssh_agent_auth & peer jumps work without -A.
			echo "	ForwardAgent yes"
			if [[ $has_key == yes ]]; then
				# Laptop client key, installed in ~/.ssh.
				echo "	IdentityFile ~/.ssh/id_ecdsa_$self"
				echo "	IdentitiesOnly yes"
			fi
		fi
		echo "	ConnectTimeout 10"
		# First connection records the host key; a changed key is refused.
		echo "	StrictHostKeyChecking accept-new"
	done
}

# valid_ssh_pubkey FILE: 0 if FILE contains a single valid OpenSSH public key
# line with no leading authorized_keys options or control characters.
valid_ssh_pubkey() {
	local f=$1 line count=0
	[[ -s $f ]] || return 1
	while IFS= read -r line || [[ -n $line ]]; do
		[[ -z $line ]] && continue
		count=$((count + 1))
		((count == 1)) || return 1
		[[ $line =~ ^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521)|sk-[^[:space:]]+)[[:space:]][A-Za-z0-9+/=]+([[:space:]][^[:cntrl:]]*)?$ ]] || return 1
	done <"$f"
	((count == 1)) || return 1
	ssh-keygen -l -f "$f" >/dev/null 2>&1
}

# The managed block of admin_role's authorized_keys: ONLY personal ssh_clients
# (laptop, phone...). Server host keys are never authorized for admin_role so
# servers cannot move laterally without an explicitly forwarded/loaded client key.
SSH_BEGIN='# >>> box ssh-keys: the other hosts (managed, edit outside this block)'
SSH_END='# <<< box ssh-keys'
gen_authorized_block() {
	local pub c line
	echo "$SSH_BEGIN"
	for c in $(get ssh_clients ""); do
		pub=$(client_key "$c")
		if valid_ssh_pubkey "$pub"; then
			while IFS= read -r line || [[ -n $line ]]; do
				[[ -n $line ]] && printf '%s\n' "$line"
			done <"$pub"
		fi
	done
	echo "$SSH_END"
}

# /etc/ssh/sudo_authorized_keys (root-owned, for pam_ssh_agent_auth): ONLY
# personal ssh_clients public keys, never server host keys.
gen_sudo_authorized_keys() {
	local pub c line
	echo "# Generated by box ssh-keys: SSH client keys allowed to authenticate sudo."
	for c in $(get ssh_clients ""); do
		pub=$(client_key "$c")
		if valid_ssh_pubkey "$pub"; then
			while IFS= read -r line || [[ -n $line ]]; do
				[[ -n $line ]] && printf '%s\n' "$line"
			done <"$pub"
		fi
	done
}

# /root/.ssh/authorized_keys is exclusively managed by box ssh-keys: peer hosts'
# keys, locked to srv-sync-endpoint so a peer key can never open a root shell.
gen_root_authorized_keys() {
	local h pub line
	echo "$SSH_BEGIN"
	for h in $(peers); do
		pub=$(host_key "$h").pub
		if valid_ssh_pubkey "$pub"; then
			while IFS= read -r line || [[ -n $line ]]; do
				[[ -n $line ]] && printf 'restrict,command="%s" %s\n' "$SRV_SYNC_ENDPOINT" "$line"
			done <"$pub"
		fi
	done
	echo "$SSH_END"
}

# A client that is a machine of ours with box (a laptop, host=<name> in its
# host file) may instead have a pair made by box on the leader, like a host's:
# <data>/keys/ssh/id_ecdsa_<name>; box ssh-keys there installs it.
client_key() {
       if [[ -s $(ssh_dir)/clients/$1.pub ]]; then
               echo "$(ssh_dir)/clients/$1.pub"
       elif [[ -s $(host_key "$1").pub ]]; then
               echo "$(host_key "$1").pub"
       else
               echo "$(ssh_dir)/clients/$1.pub"
       fi
}

# check_ssh_clients: each one has a valid public key, authorized here.
check_ssh_clients() {
	local c pub auth
	auth=$(authorized_keys_file)
	for c in $(get ssh_clients ""); do
		pub=$(client_key "$c")
		if [[ ! -s $pub ]]; then
			fail "ssh client $c has no key: $pub (one line, from ~/.ssh/*.pub on that machine)"
		elif ! ssh-keygen -l -f "$pub" >/dev/null 2>&1; then
			fail "$pub is not a valid public key"
		elif grep -qF "$(awk '{print $2}' "$pub")" "$auth" 2>/dev/null; then
			ok "client $c may log in as $(admin_role)"
		else
			fail "client $c's key is not in $auth: box ssh-keys"
		fi
	done
	return 0
}

# gen_authorized_keys FILE: FILE with the managed block replaced (or added
# at the end). The other keys (yours) are kept.
gen_authorized_keys() {
	local file=$1
	if [[ -f $file ]]; then
		awk -v b="$SSH_BEGIN" -v e="$SSH_END" '
			$0 == b {skip = 1; next}
			$0 == e {skip = 0; next}
			!skip' "$file"
	fi
	gen_authorized_block
}

authorized_keys_file() { echo "$(account_home "$(admin_role)")/.ssh/authorized_keys"; }


# Directories inside <data> that hold secrets or database dumps and must be
# strictly root:root (0700 dirs, 0600 files), unreachable by unix_role.
# (keys/tor stays UID 1000 because srv-onion bind-mounts it directly.)
PROTECTED_SECRET_DIRS=(
	keys/ssh keys/acme keys/ssl keys/opendkim keys/postsrsd
	keys/dns keys/websso keys/mariadb keys/alerts backups
)

protect_data_secrets() {
	local data backup rel p
	data=$(get data_dir /home/data)
	backup=$(get backup_dir /home/backup)
	for rel in "${PROTECTED_SECRET_DIRS[@]}"; do
		p="$data/$rel"
		[[ -d $p ]] || continue
		chown -R 0:0 "$p"
		find "$p" -type d -exec chmod 0700 {} +
		find "$p" -type f -exec chmod 0600 {} +
	done
	if [[ -d $backup ]]; then
		# Top-level only: blocks unix_role traversal while preserving original
		# file ownership inside snapshots (needed for rsync --link-dest between backups).
		chown 0:0 "$backup"
		chmod 0700 "$backup"
	fi
}

# check_unix_role: the account named by unix_role exists with uid 1000, and
# when separated from admin_role has no sudo privileges and no SSH key access.
check_unix_role() {
	local role adm uid home allow
	role=$(unix_role)
	adm=$(admin_role)
	if ! uid=$(id -u "$role" 2>/dev/null); then
		fail "no account $role (unix_role): useradd -m -u 1000 $role"
		return 0
	elif [[ $uid != 1000 ]]; then
		fail "$role (unix_role) has uid $uid, not 1000: the services' files and containers use 1000 ($(getent passwd 1000 | cut -d: -f1 || echo nobody) has it)"
	else
		ok "$role (unix_role) has uid 1000"
	fi

	if [[ $role == "$adm" ]]; then
		warn "unix_role ($role) and admin_role ($adm) are the same account: set unix_role/admin_role and run box apply-role-change"
		if sudo -l -U "$adm" 2>/dev/null | grep -q 'NOPASSWD:'; then
			warn "$adm (admin_role) has NOPASSWD sudo rules (check /etc/sudoers.d/*)"
		fi
		return 0
	fi

	# Verify unix_role has a non-login shell (/usr/sbin/nologin or /bin/false).
	local rshell
	rshell=$(getent passwd "$role" | cut -d: -f7)
	case $rshell in
		/usr/sbin/nologin | /sbin/nologin | /bin/false | /usr/bin/false)
			ok "$role (unix_role) shell is $rshell"
			;;
		*)
			fail "$role (unix_role) has login shell '$rshell': usermod -s /usr/sbin/nologin $role"
			;;
	esac

	# Verify unix_role has no sudo privileges.
	if id -nG "$role" 2>/dev/null | grep -qwE 'sudo|wheel'; then
		fail "$role (unix_role) is in the sudo/wheel group: gpasswd -d $role sudo"
	elif sudo -l -U "$role" 2>/dev/null | grep -q 'may run the following commands'; then
		fail "$role (unix_role) has sudoers privileges (check /etc/sudoers and /etc/sudoers.d)"
	else
		ok "$role (unix_role) has no sudo privileges"
	fi

	# Warn if admin_role still has passwordless sudo (e.g. cloud-init drop-in).
	if id "$adm" >/dev/null 2>&1; then
		if sudo -l -U "$adm" 2>/dev/null | grep -q 'NOPASSWD:'; then
			warn "$adm (admin_role) has NOPASSWD sudo rules (check /etc/sudoers.d/*)"
		else
			ok "$adm (admin_role) sudo requires a password"
		fi
	fi

	# Verify unix_role has no SSH keys or SSH login access.
	home=$(account_home "$role")
	if [[ -n $home && ( -e $home/.ssh/authorized_keys || -n $(compgen -G "$home/.ssh/id_*" 2>/dev/null || true) ) ]]; then
		fail "$role (unix_role) has SSH keys in $home/.ssh: rm -rf $home/.ssh"
	else
		ok "$role (unix_role) has no SSH keys"
	fi
	allow=$(sshd -T 2>/dev/null | awk '$1 == "allowusers" { $1=""; print $0 }')
	if [[ -n $allow && " $allow " == *" $role "* ]]; then
		fail "$role (unix_role) is in sshd AllowUsers: box ssh"
	fi
	return 0
}

check_ssh_peers() {
	local self key h a ahome out level=warn auth rauth
	self=$(get host) key=$(host_key "$(get host)")
	[[ $(get is_leader no) == yes ]] && level=fail

	case $(sshd -T 2>/dev/null | awk '$1 == "permitrootlogin" {print $2}') in
		forced-commands-only) ok "sshd root login restricted to forced-commands-only" ;;
		"") warn "cannot read sshd's settings (sshd -T)" ;;
		*) fail "sshd PermitRootLogin should be forced-commands-only (for restricted root peer sync): box ssh" ;;
	esac
	if [[ $(get in_inventory yes) == yes ]]; then
		if [[ -x $SRV_SYNC_ENDPOINT && $(stat -c '%u:%g %a' "$SRV_SYNC_ENDPOINT" 2>/dev/null) == "0:0 755" ]] &&
			cmp -s "$REPO/host/ssh/srv-sync-endpoint" "$SRV_SYNC_ENDPOINT"; then
			ok "$SRV_SYNC_ENDPOINT installed"
		else
			fail "$SRV_SYNC_ENDPOINT missing, outdated, or wrong mode/owner: box ssh-keys"
		fi
		if [[ -f $SRV_SYNC_CONF && $(stat -c '%u:%g %a' "$SRV_SYNC_CONF" 2>/dev/null) == "0:0 600" ]] &&
			! differs "$SRV_SYNC_CONF" gen_sync_endpoint_conf; then
			ok "$SRV_SYNC_CONF matches data_dir"
		else
			fail "$SRV_SYNC_CONF missing, outdated, or wrong mode/owner: box ssh-keys"
		fi
	fi
	local want_pw
	want_pw=$(ssh_password_auth) || return 1
	case $(sshd -T 2>/dev/null | awk '$1 == "passwordauthentication" {print $2}') in
		"$want_pw") ok "sshd PasswordAuthentication is $want_pw" ;;
		"") ;;
		*) fail "sshd PasswordAuthentication is not $want_pw: box ssh" ;;
	esac

	if [[ ! -s $key || ! -s $key.pub ]]; then
		fail "no ssh key pair $key(.pub): box ssh-keys on the leader"
		return 0
	fi
	[[ $(stat -c %a "$key") == 600 ]] || fail "$key is readable by others: chmod 600"
	if [[ $(ssh-keygen -y -f "$key" 2>/dev/null | awk '{print $2}') != "$(awk '{print $2}' "$key.pub")" ]]; then
		fail "$key.pub does not belong to $key"
		return 0
	fi
	for a in $(key_accounts); do
		ahome=$(account_home "$a")
		if cmp -s "$key" "$ahome/.ssh/id_ecdsa_$self"; then
			ok "key installed for $a"
		else
			fail "$ahome/.ssh/id_ecdsa_$self missing or different from $key: box ssh-keys"
		fi
	done

	# Off the inventory (a laptop) nobody logs in here: no keys to authorize.
	if [[ $(get in_inventory yes) == yes ]]; then
		local adm_home
		adm_home=$(account_home "$(admin_role)")
		if [[ -n $adm_home && -e $adm_home/.ssh/id_ecdsa_$self ]]; then
			fail "$adm_home/.ssh/id_ecdsa_$self should not be in $(admin_role)'s ~/.ssh (server key is root-sync only): box ssh-keys"
		fi
		auth=$(authorized_keys_file)
		rauth="/root/.ssh/authorized_keys"
		if [[ -f $rauth ]]; then
			local rline bad_root=0
			while IFS= read -r rline || [[ -n $rline ]]; do
				[[ -z $rline || $rline == \#* ]] && continue
				if [[ $rline != "restrict,command=\"$SRV_SYNC_ENDPOINT\" "* ]]; then
					bad_root=1
					break
				fi
			done <"$rauth"
			if ((bad_root)); then
				fail "$rauth contains an unrestricted key (expected restrict,command=\"$SRV_SYNC_ENDPOINT\"): box ssh-keys"
			else
				ok "$rauth keys restricted to $SRV_SYNC_ENDPOINT"
			fi
		fi
		for h in $(peers); do
			if [[ ! -s $(host_key "$h").pub ]]; then
				fail "no public key for $h in $(ssh_dir): box ssh-keys on the leader"
			else
				local pubkey
				pubkey=$(awk '{print $2}' "$(host_key "$h").pub")
				if grep -qF "restrict,command=\"$SRV_SYNC_ENDPOINT\" " "$rauth" 2>/dev/null && grep -qF "$pubkey" "$rauth" 2>/dev/null; then
					ok "$h may sync as root (forced-command)"
				else
					fail "$h's key is not in $rauth: box ssh-keys"
				fi
				if grep -qF "$pubkey" "$auth" 2>/dev/null; then
					fail "$h's server key is in $auth (server keys must not allow lateral admin login): box ssh-keys"
				fi
			fi
		done
	fi

	[[ -s /etc/ssh/ssh_config.d/srv.conf ]] || fail "no ssh client settings for the other hosts: box ssh-keys"
	for h in $(peers); do
		if out=$(ssh -F /etc/ssh/ssh_config -o BatchMode=yes "$h" true 2>&1); then
			ok "ssh to $h"
		else
			"$level" "ssh to $h ($(get "${h}_ip"), port $(peer_ssh_port "$h")) fails: $(tail -n 1 <<<"$out")"
		fi
	done
	return 0
}

