gen_msmtp_aliases() {
	cat <<-EOF
		# Generated by box alerts: local mail (cron, root...) goes to alert_email.
		default: $(get alert_email "")
	EOF
}

alerts_configured() { [[ -n $(get alert_email "") ]]; }

gen_hostname() { get host; }

# /etc/hosts: localhost, then every host of the inventory, so the hosts
# reach each other by name even when DNS is down (e.g. during a takeover).
gen_hosts() {
	local domain h ip6
	domain=$(get domain blunderer.org)
	cat <<-EOF
		# Generated by box hostname from the inventory (hosts.env).
		# Local additions are lost on the next run: put them in the inventory.
		127.0.0.1	localhost
		::1		localhost ip6-localhost ip6-loopback
		ff02::1		ip6-allnodes
		ff02::2		ip6-allrouters

	EOF
	for h in $(get hosts); do
		printf '%s\t%s.%s %s\n' "$(get "${h}_ip")" "$h" "$domain" "$h"
		ip6=$(get "${h}_ip6" "")
		[[ -z $ip6 ]] || printf '%s\t%s.%s %s\n' "$ip6" "$h" "$domain" "$h"
	done
}

# ------------------------------------------------------------------ hostname


gen_cloud_cfg() {
	cat <<-'EOF'
		# Generated by box hostname: keep cloud-init from resetting the
		# hostname and /etc/hosts at boot.
		preserve_hostname: true
		manage_etc_hosts: false
	EOF
}

# ------------------------------------------------------------------ resolver

# systemd-resolved listens on 127.0.0.53/.54:53, which keeps Docker from
# publishing port 53 for the dns service. Turning only its stub listener off
# did not survive every reboot, so box resolver stops, disables and masks it,
# and writes a plain /etc/resolv.conf: host_resolvers from the host config,
# else the upstream servers resolved was using, else public ones.
# shellcheck disable=SC2034 # used by cmd/box/resolver.sh
RESOLVED_DROPIN=/etc/systemd/resolved.conf.d/srv.conf
RESOLV_UPSTREAM=/run/systemd/resolve/resolv.conf
RESOLV_HEADER="# Generated by box resolver (host_resolvers): systemd-resolved is masked."

resolved_active() { systemctl is-active -q systemd-resolved 2>/dev/null; }
resolved_installed() { systemctl cat systemd-resolved >/dev/null 2>&1; }
resolved_masked() { [[ $(systemctl is-enabled systemd-resolved 2>/dev/null) == masked ]]; }

# The servers the host resolves through: never a loopback address (the dns
# service is authoritative only, and the resolved stub is gone).
host_resolvers() {
	local list f
	list=$(get host_resolvers "")
	if [[ -z $list ]]; then
		for f in "$RESOLV_UPSTREAM" /etc/resolv.conf; do
			[[ -r $f ]] || continue
			list=$(awk '$1 == "nameserver" && $2 !~ /^(127\.|::1$)/ {print $2}' "$f" | head -n 3 | xargs)
			[[ -z $list ]] || break
		done
	fi
	echo "${list:-1.1.1.1 9.9.9.9}"
}

gen_resolv_conf() {
	local ns
	echo "$RESOLV_HEADER"
	for ns in $1; do echo "nameserver $ns"; done
	echo "options edns0 timeout:2 attempts:2"
}

# /etc/resolv.conf is box's own file (not a link to resolved's).
resolv_managed() {
	[[ -f /etc/resolv.conf && ! -L /etc/resolv.conf ]] && head -n 1 /etc/resolv.conf | grep -qxF "$RESOLV_HEADER"
}

# check_mail_names: for this host's IPv4 and (if in the inventory) IPv6
# address, the reverse name is the mail name (server_name) and the mail name
# resolves back to the address. The reverse is set at the hosting provider.
check_mail_names() {
	local name ip rev fwd
	name=$(get server_name)
	for ip in "$(get host_ip)" "$(get "$(get host)_ip6" "")"; do
		[[ -n $ip ]] || continue
		# getent exits 2 when nothing is found: not an error here.
		rev=$({ getent hosts "$ip" 2>/dev/null || true; } | awk 'NR == 1 {print $2}')
		fwd=$({ getent ahosts "$name" 2>/dev/null || true; } | awk '{print $1}' | sort -u | xargs)
		if [[ ${rev%.} != "$name" ]]; then
			warn "reverse of $ip is ${rev:-missing}, expected $name (set it at the hosting provider)"
		elif [[ " $fwd " != *" $ip "* ]]; then
			warn "$name does not resolve to $ip (it gives: ${fwd:-nothing}); deploy dns on the leader"
		else
			ok "$ip <-> $name"
		fi
	done
	if [[ -z $(get "$(get host)_ip6" "") ]]; then
		ok "no IPv6 in the inventory for this host: mail goes out over IPv4"
	fi
}

# port_53_users: listeners on port 53 other than our containers' own forwarders.
port_53_users() {
	{ ss -Htulpn '( sport = :53 )' 2>/dev/null || true; } |
		{ grep -vE '"(docker-proxy|pasta(\.[^"]*)?|rootlessport)"' || true; } |
		awk '{print $1 " " $5 " " $7}'
}

# ---------------------------------------------------------------------- ipv6
#
# The inventory's <host>_ip6 is published in DNS (AAAA, glue) and used for
# outgoing mail, so the host must really have it. Providers that route a /64
# without router advertisements (OVH dedicated servers) need it configured by
# hand: with ip6_gw in the host file, box ipv6 installs a systemd unit that
# sets the address and the default route at boot (ip ... replace: harmless
# next to the same settings from the system's own network configuration).
# Without ip6_gw, the address is expected from the provider (cloud-init,
# router advertisements); box check verifies it either way.

IPV6_UNIT=/etc/systemd/system/srv-ipv6.service

# ip6_intf: ip6_intf in the host file, else the interface of the IPv4 default
# route.
ip6_intf() {
	local i
	i=$(get ip6_intf "")
	[[ -n $i ]] || i=$(ip -4 route show default 2>/dev/null | awk '{for (n = 1; n < NF; n++) if ($n == "dev") {print $(n + 1); exit}}')
	echo "$i"
}

gen_ipv6_unit() {
	local addr intf gw prefix
	addr=$(get "$(get host)_ip6" "")
	gw=$(get ip6_gw "")
	intf=$(ip6_intf)
	prefix=$(get ip6_prefix 64)
	cat <<-EOF
		# Generated by box ipv6: $(get host)_ip6 (inventory), ip6_gw and ip6_intf (host file).
		[Unit]
		Description=IPv6 address and default route from the srv host files (box ipv6)
		After=network-online.target
		Wants=network-online.target

		[Service]
		Type=oneshot
		RemainAfterExit=yes
		ExecStart=/usr/sbin/ip -6 addr replace $addr/$prefix dev $intf
	EOF
	# A gateway outside the prefix (OVH: ...ff:ff:ff:ff:ff) is reached directly
	# on the link; a link-local one (fe80::1) is on the link already.
	[[ $gw == fe80:* ]] || echo "ExecStart=/usr/sbin/ip -6 route replace $gw dev $intf"
	cat <<-EOF
		ExecStart=/usr/sbin/ip -6 route replace default via $gw dev $intf
		ExecStop=-/usr/sbin/ip -6 route del default via $gw dev $intf

		[Install]
		WantedBy=multi-user.target
	EOF
}


# check_ipv6: the inventory's address is on an interface, there is an IPv6
# default route, and the internet answers over IPv6.
check_ipv6() {
	local addr
	addr=$(get "$(get host)_ip6" "")
	[[ -n $addr ]] || return 0
	if ! ip -6 addr show scope global | grep -qiw "inet6 $addr"; then
		fail "$addr ($(get host)_ip6) is not on any interface: AAAA records and mail point to it (set ip6_gw, then box ipv6)"
		return 0
	fi
	if [[ -z $(ip -6 route show default) ]]; then
		fail "$addr is configured, but there is no IPv6 default route (set ip6_gw, then box ipv6)"
	elif ping -6 -c 1 -W 3 2606:4700:4700::1111 >/dev/null 2>&1 || ping -6 -c 1 -W 3 2620:fe::fe >/dev/null 2>&1; then
		ok "IPv6 $addr: configured, and the internet answers"
	else
		fail "IPv6 $addr is configured, but nothing answers over it (gateway ip6_gw=$(get ip6_gw "") right?)"
	fi
}

# --------------------------------------------------------------------- shell
#
# The same shell everywhere: ~/.bashrc and ~/.profile from host/shell/ for
# root and the admin account (unix_role), on every host. Per-host or personal
# additions go in ~/.bashrc.local and ~/.profile.local, which box leaves alone.

SHELL_FILES=(bashrc profile)

# shell_users: "user home" for root and admin_role.
shell_users() {
	local u
	for u in root "$(admin_role)"; do
		[[ -n $u ]] || continue
		getent passwd "$u" | awk -F: '{print $1, $6}'
	done | sort -u
}


# check_shell_user USER HOME: the files are box's, and nothing makes bash skip
# ~/.profile (it reads ~/.bash_profile or ~/.bash_login instead, if present).
check_shell_user() {
	local u=$1 home=$2 f bad=()
	for f in "${SHELL_FILES[@]}"; do
		cmp -s "$REPO/host/shell/$f" "$home/.$f" || bad+=(".$f")
	done
	if ((${#bad[@]})); then
		warn "$u: ${bad[*]} differ from host/shell (box shell; own additions go in ~/.bashrc.local)"
	else
		ok "$u: ~/.bashrc and ~/.profile are box's"
	fi
	for f in .bash_profile .bash_login; do
		[[ -e $home/$f ]] && warn "$u: $home/$f exists, so bash ignores ~/.profile at login (move its content to ~/.profile.local, then delete it)"
	done
	return 0
}

# ----------------------------------------------------------------------- man
#
# The manual pages of what runs in the containers (postconf(5), named.conf(5),
# nginx(8)...), readable on the host with man. The images are slim and have
# none, so box man takes them from Debian's packages of the same programs:
# MANPAGES in each enabled service's service.env names them. The packages are
# downloaded and only their pages extracted, into /usr/local/share/man; none
# is installed. Debian's versions may differ a little from the images'.

# shellcheck disable=SC2034 # used by cmd/box/man.sh
MAN_DIR=/usr/local/share/man
MAN_STATE=/var/lib/srv-host/manpages

# man_wanted: the packages named by MANPAGES of this host's services, sorted.
man_wanted() {
	local svc f
	for svc in $(get services); do
		f=$REPO/services/$svc/service.env
		[[ -f $f ]] || continue
		sed -n 's/^MANPAGES="\(.*\)"$/\1/p' "$f"
	done | tr ' ' '\n' | sed '/^$/d' | sort -u
}


# check_man: the pages installed are those of this host's services.
check_man() {
	local want
	want=$(man_wanted)
	[[ -n $want ]] || return 0
	if [[ $want == "$(cat "$MAN_STATE" 2>/dev/null)" ]]; then
		ok "man pages of the services' programs installed ($(wc -l <"$MAN_STATE.files" 2>/dev/null || echo 0) pages)"
	else
		warn "the man pages do not match this host's services: box man"
	fi
}


# ------------------------------------------------------------------ packages


# box link: srv and box on the PATH (sudo keeps /usr/local/bin), so neither
# needs its full path. First step of setup: nothing it needs can fail.
# shellcheck disable=SC2034 # used by cmd/box/{link,unlink}.sh
LINKS=(srv box remote)

# The data folder before the host env exists: DATA_DIR given to link/unlink,
# else the one the current host env names, else /home/data.
link_data_dir() {
	if [[ -n ${1:-} ]]; then
		echo "${1%/}"
	elif [[ -e $SRV_HOST_ENV ]]; then
		get data_dir /home/data
	else
		echo /home/data
	fi
}


# unlink_if_into LINK DIR: remove LINK if it is a symlink to a file in DIR.
unlink_if_into() {
	local link=$1 dir=$2 target
	target=$(readlink -f "$link" 2>/dev/null || true)
	if [[ ! -L $link ]]; then
		if [[ -e $link ]]; then warn "$link is a file, not a link: left alone"; else ok "no $link"; fi
	elif [[ $target == "$dir"/* ]]; then
		rm -f "$link"
		ok "removed $link"
	else
		warn "$link points to $target, not into $dir: left alone"
	fi
}

