STATE_DIR=/var/lib/srv-host
PAUSE_FLAG=$STATE_DIR/backups-paused
# Jobs `box backups pause` stops: the local and remote copies of the
# data folder, and certificate renewal (its challenge files and the new
# certificate are pushed to the other hosts). The database dump keeps running:
# it only writes locally.
# shellcheck disable=SC2034 # used by cmd/box/run.sh
PAUSABLE_JOBS="backup data-push ssl-renew"

backups_paused() { [[ -f $PAUSE_FLAG ]]; }
paused_since() { date -d "@$(stat -c %Y "$PAUSE_FLAG")" '+%Y-%m-%d %H:%M' 2>/dev/null; }


