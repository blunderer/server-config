# need_current SVC: load the service and set CUR to its current srv release.
CUR=''
need_current() {
	local svc=$1
	load_host
	load_meta "$svc"
	CUR=$(read_link "$svc" current)
	[[ -n $CUR ]] || die "$svc has no srv release running (status: srv status $svc)"
}


# diff_release_trees DIR_A LABEL_A DIR_B LABEL_B [DIFF_ARGS...]:
# compare two rendered release directories while normalizing release names and
# release paths so only real config or image/unit changes are shown.
diff_release_trees() {
	local da=$1 la=$2 db=$3 lb=$4 tmp ra rb pa pb rc=0
	shift 4
	ra=${da##*/}
	rb=${db##*/}
	pa=$(realpath -m "$da")
	pb=$(realpath -m "$db")
	tmp=$(mktemp -d)
	cp -a "$da" "$tmp/a"
	cp -a "$db" "$tmp/b"
	rm -f "$tmp/a/release.info" "$tmp/b/release.info"
	find "$tmp/a" -type f -exec sed -i \
		-e "s|$pa|<RELEASE_DIR>|g" \
		-e "s|$da|<RELEASE_DIR>|g" \
		-e "s|^SRV_RELEASE=.*|SRV_RELEASE=<REL>|" \
		-e "s|:${ra}\([[:space:]]*\\)\$|:<REL>\\1|" {} +
	find "$tmp/b" -type f -exec sed -i \
		-e "s|$pb|<RELEASE_DIR>|g" \
		-e "s|$db|<RELEASE_DIR>|g" \
		-e "s|^SRV_RELEASE=.*|SRV_RELEASE=<REL>|" \
		-e "s|:${rb}\([[:space:]]*\\)\$|:<REL>\\1|" {} +
	(cd "$tmp" && diff -ru "$@" a b) | \
		sed -e "s|^\\(--- \\|+++ \\)a/|\\1$la/|" -e "s|^\\(--- \\|+++ \\)b/|\\1$lb/|" || true
	# Re-run exit status check cleanly because pipe masks diff return code.
	(cd "$tmp" && diff -ru "$@" a b >/dev/null 2>&1) || rc=$?
	rm -rf "$tmp"
	return "$rc"
}


