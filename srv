# ------------------------------------------------------------------- main

load_cmd() {
	local f="$SRV_ROOT/cmd/srv/$1.sh"
	[[ -f $f ]] || die "unknown command '$1' (srv help)"
	# shellcheck source=/dev/null
	. "$f"
}

main() {
	SRV_ARGS="$*"
	while [[ ${1:-} == -* ]]; do
		case $1 in
			-y | --yes) SRV_YES=1 ;;
			-v | --verbose) SRV_VERBOSE=1 ;;
			-h | --help) load_cmd help; cmd_help; return 0 ;;
			*) die "unknown option $1" ;;
		esac
		shift
	done
	local cmd=${1:-help}
	shift || true
	[[ $cmd =~ ^[a-z0-9-]+$ ]] || die "unknown command '$cmd' (srv help)"
	load_cmd "$cmd"
	"cmd_${cmd//-/_}" "$@"
}

main "$@"
