# Values for ONE host (here: orion). Documentation only: real values never go
# in git. Values shared by every host live in the inventory, hosts.env (see
# examples/example-hosts.env); anything set here overrides it.
#
# On a server:
#   cp examples/example.env /home/data/configs/<host>.env      # then edit it
#   cp examples/example-hosts.env /home/data/configs/hosts.env # once, then edit
#   mkdir -p /etc/srv && ln -sf /home/data/configs/<host>.env /etc/srv/host.env
#
# Format: KEY=value, one per line, no shell evaluation. Templates in
# services/*/config and services/*/quadlet reference these as @key@.

# --- This host -------------------------------------------------------------
# Name of this host in the inventory (hosts= in hosts.env).
host=orion
# Services deployed on this host (srv services shows them in dependency order).
# Empty or absent: none (a host that only keeps the data folder, e.g. a laptop).
# Such a host need not be in the inventory's hosts= either: it can still
# box data pull (from the leader) and run remote.
# Available: dns db web onion mail torrent jellyfin vpn minecraft agy
services="dns db web onion mail torrent"
# Where the replicated data folder lives (keys, users, www, databases...).
data_dir=/home/data
# Owner (user:group or uid:gid) of what srv and box create in it while
# run as root. Default: the owner of data_dir itself (normally blunderer).
#data_owner=blunderer:blunderer
# Where host-local service volumes live (mail queue/reports, DNS zones/cache,
# Tor state, shared sockets, agy agent state, Jellyfin downloads overlay, agy
# shared-folder overlays). Not replicated across hosts; changing it later
# migrates existing folders on srv deploy and srv commit.
volumes_dir=/home/volumes
tz=Europe/Paris
# Mail hostname (HELO, ARC/DKIM authserv-id). Default: the host's first
# mailN name from the inventory (mail0.blunderer.org), else <host>.blunderer.org.
#server_name=mail0.blunderer.org

# --- DNS -------------------------------------------------------------------
# Derived from the inventory: the leader is the DNS master, the others are
# slaves. Override only for tests: dns_role=master|slave.
# Extra SPF mechanisms for every zone, starting with a space, e.g. while a
# test server sends mail. Optional (none if unset):
#spf_extra=" ip4:203.0.113.7 ip6:2001:db8:2::7"

# --- Web / onion ------------------------------------------------------------
# Name of the onion service (directory under <data_dir>/keys/tor/). Optional:
# without it, the onion service cannot run (box check fails if onion is in
# services=) and the websites send no Onion-Location header.
onion_name=exampleonionaddressxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Google accounts seeded into <data_dir>/users/websso/torrent.blunderer.org
# on first torrent deploy (space- or comma-separated; default: alert_email).
# Each SSO-protected domain has its own allowlist in <data_dir>/users/websso/<fqdn>.
# OAuth credentials (<data_dir>/keys/websso/oauth2.cfg) are managed with: box keys new websso.
#sso_emails="tristan@blunderer.org"

# --- Torrent ---------------------------------------------------------------
torrent_dir=/home/torrent

# --- VPN (WireGuard) -------------------------------------------------------
# Comma-separated peer names; one client config is generated for each.
wg_peers=laptop,phone

# --- Podman storage --------------------------------------------------------
# Rootless Podman image/container graphroot for unix_role (must be on ext4,
# xfs or btrfs, off a small root partition). Default: /home/podman.
podman_storage_dir=/home/podman

# --- Host (box) ----------------------------------------------------------
# sshd port. box opens it next to 22; `box ssh-confirm` closes 22.
ssh_port=222
# Password login over ssh is disabled by default; set to yes only when needed.
#ssh_password_auth=yes
# Accounts allowed to log in over ssh (space-separated; default: admin_role,
# set empty to leave AllowUsers unset).
#ssh_allow_users="blunderer"
# Local incremental backups of the data folder.
backup_dir=/home/backup
# Certificate renewal runs on the leader; force with yes/no.
#ssl_renew=yes

# --- Email alerts (box alerts) -------------------------------------------
# Failed cron jobs, failed checks, needed reboots, configuration drift and a
# weekly report go to this address. Empty: no alerts.
alert_email=tristan@blunderer.org
# Sent through the mail service with SMTP AUTH (account created by
# `box alerts-account`). Defaults shown.
# Default: this host's own mailN name when it runs mail, else the leader's
# (mail0.blunderer.org): a name the certificate covers.
#alert_smtp_host=mail0.blunderer.org
#alert_smtp_port=587
#alert_smtp_user=alerts
#alert_from=alerts@blunderer.org

# --- Optional --------------------------------------------------------------
# Podman Quadlet networks (defaults shown).
#podman_web_subnet=10.89.1.0/24
#podman_web_gw=10.89.1.1
#podman_web_subnet6=fd5a:7372:7611::/64
#podman_web_gw6=fd5a:7372:7611::1
#podman_db_subnet=10.89.2.0/24
#podman_db_gw=10.89.2.1
#podman_db_ip=10.89.2.2
# Hosts the leader pushes the data folder and certificates to. Default: every
# other host of the inventory, as unix_role@<ip>.
#remote_hosts="blunderer@198.51.100.20"

# IPv6, when the inventory has <host>_ip6 but the provider does not configure
# it (OVH dedicated servers: a routed /64, no router advertisements). With
# ip6_gw, box ipv6 (part of setup) installs a boot unit for the address and
# the default route. The gateway is in the provider's control panel: on OVH,
# the /64 with its last 5 groups as ff (2001:db8:0:1ff:ff:ff:ff:ff), or
# fe80::1. ip6_intf defaults to the IPv4 default route's interface;
# ip6_prefix to 64. Unset: the address is expected from the provider.
#ip6_gw=2001:db8:0:1ff:ff:ff:ff:ff
#ip6_intf=enp1s0
#ip6_prefix=64

# agy (Antigravity CLI agents, docs/agy.md). agy_instances: one isolated
# sandbox (container, volumes, sign-in) per name, agy-<name> on the Remote
# Control dashboard (default: one, "agy"). agy_mem: memory of each.
# agy_sync_dir: where srv hook agy sync copies a workspace when given no
# folder (plus /<instance> when there are several).
#agy_instances="site api"
#agy_mem=2g
#agy_sync_dir=/home/blunderer/agy

# Name servers the host itself resolves through (/etc/resolv.conf, written by
# box resolver, which masks systemd-resolved). Default: the provider's
# servers resolved was using, else 1.1.1.1 9.9.9.9. Never 127.0.0.1: the dns
# service is authoritative only.
#host_resolvers="213.186.33.99 2001:41d0:3:163::1"

# --- Minecraft (Bedrock) -----------------------------------------------------
# All optional. Players are added with: box minecraft allow <gamertag>.
#minecraft_name="blunderer.org"      # shown in the game's server list
#minecraft_gamemode=survival         # survival, creative, adventure
#minecraft_difficulty=easy           # peaceful, easy, normal, hard
#minecraft_max_players=10
