# Inventory shared by every host: which machines exist and who does what.
# Documentation only: real values never go in git. On the servers it lives in
# <data>/configs/hosts.env, replicated with the data folder (from the leader).
#
# The addresses below are documentation ranges (RFC 5737 / RFC 3849).

# Every host, by name. Each needs <name>_ip; <name>_ip6 is optional: with it,
# the host's names get AAAA records and its mail goes out over IPv6 too (set
# the IPv6 reverse name at the provider first, docs/mail.md "IPv6").
hosts="orion lyra vega"

orion_ip=192.0.2.10
orion_ip6=2001:db8::10
# DNS records in blunderer.org pointing to this machine (besides orion.):
# the name servers and mail hosts of the zones, matching its reverse DNS.
# A name gets an A record, plus AAAA when <host>_ip6 is set; ending it in :4
# keeps only the A record, :6 only the AAAA (ns6:6: an IPv6-only name server,
# for an IPv6 glue record at the registrar).
orion_names="ns0 mail0 ns6:6"

lyra_ip=198.51.100.20
lyra_ip6=2001:db8:1::20
lyra_names="ns1 mail1 backup ns7:6"

# Test/spare machine: a DNS slave (kept in sync) but not in the NS or MX records.
vega_ip=203.0.113.7
vega_names=""

# NS records of every zone (and of the acme./smtp. delegations): hosts or
# their names, which must match the glue records at the registrar.
# Default "ns0 ns1".
ns="ns0 ns1 ns6 ns7"

# Spam (rspamd, docs/mail.md "Spam filtering"): unset, messages are only
# tagged with their score (X-Spamd-Result); a score rejects mail from it up,
# during the SMTP conversation, so it never reaches Gmail.
#spam_reject=15

# MX records of every zone, in order of preference (priority 100, 200...):
# hosts or their names. Default "mail0 mail1". With host names
# (mx="orion lyra vega"), each mail host introduces itself and should have its
# reverse DNS as <host>.blunderer.org; mail0/mail1 stay as names for clients
# sending through the server (docs/mail.md, "MX and mail names").
#mx="mail0 mail1"

# The leader: DNS master (zones are edited and rendered there), source of
# the nightly data replication, renews the certificates.
# Hand it over with: box leader <name>
leader=orion

# Where the website records (blunderer.org, www, dl, libroxml...) point.
# Moved with: box migrate <from> <to>   (on the leader)
web=orion

# The unprivileged service account of every host (uid 1000): owns rootless
# Podman and container-mounted data folders. Default: blunderer.
unix_role=blunderer
# The interactive admin account (sudo + SSH logins + personal keys). Defaults
# to unix_role until separated (e.g. unix_role=srv, admin_role=blunderer).
#admin_role=blunderer

# Extra ssh clients (your laptop, phone...) trusted on every host, with
# their public keys in <data>/keys/ssh/clients/<name>.pub: they join the
# hosts' keys in unix_role's authorized_keys (box ssh-keys). Removing one
# here revokes it on each host's next run.
#ssh_clients="laptop phone"
# A client that is a machine of ours running box (host=laptop in its host
# file, not in hosts=) needs no clients/ file: box ssh-keys on the leader
# makes it a pair in keys/ssh/id_ecdsa_laptop, and box ssh-keys on the laptop
# installs it with an ssh config for every host (ssh orion just works).

# ssh port override for a host without configs/<host>.env (e.g. a host still
# on the old stack, on 22; otherwise ssh_port in configs/<host>.env is used):
#vega_ssh_port=22

# The name mail clients send through (Gmail's "Send mail as"):
# smtp.blunderer.org, one address per mail host listed here that works:
# STARTTLS with a certificate for that name, then a login with the alerts
# account. box smtp-health (cron on the leader, every 5 minutes) removes a
# host that stops working and adds it back. Each one must accept the same
# SMTP logins and serve a certificate valid for smtp.blunderer.org. Do not
# also put "smtp" in a host's <host>_names.
smtp="orion lyra"
