DESCRIPTION="Jellyfin media server (linuxserver image)"
DEPENDS="web"
LEGACY=""
VOLUMES="jellyfin-overlay"
NETWORKS="srv-web"
HEALTH_TIMEOUT=180
# Files (and folders, trailing /) that must exist; relative to data_dir.
REQUIRES="jellyfin/ @torrent_dir@/downloads/"
IMAGES="localhost/srv/jellyfin=./image"
