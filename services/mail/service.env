DESCRIPTION="Mail forwarding + submission: postfix, SASL, DKIM, ARC, SRS"
DEPENDS=""
LEGACY="mypostfix myopendkim"
VOLUMES="mail-spool mail-reports mail-saslauthd"
IMAGES="localhost/srv/mail=./image/mail localhost/srv/mail-openarc=./image/openarc localhost/srv/mail-resolver=./image/resolver"
HEALTH_TIMEOUT=120
# srv reload mail: e.g. after an SSL renewal.
RELOAD="postfix:postfix reload"
# Files (and folders, trailing /) that must exist; relative to data_dir.
REQUIRES="keys/ssl/blunderer.org/fullchain.crt keys/ssl/blunderer.org/blunderer.org.key keys/opendkim/ users/postfix/passwd users/postfix/shadow users/postfix/group configs/mail/virtual configs/mail/senders"
# Debian packages whose man pages box man installs on the host.
MANPAGES="postfix opendkim opendkim-tools postsrsd rspamd sasl2-bin unbound"
