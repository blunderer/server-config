[Unit]
Description=Mail SRS rewriter (postsrsd)

[Container]
ContainerName=srv-mail-postsrsd
Pod=srv-mail.pod
Image=localhost/srv/mail:${SRV_RELEASE}
User=0:0
DropCapability=ALL
AddCapability=CAP_SETUID CAP_SETGID
NoNewPrivileges=true
PidsLimit=128
Exec=postsrsd -C /etc/srv/postsrsd.conf
Environment=TZ=${SRV_TZ}
Volume=${SRV_RELEASE_DIR}/config/postsrsd.conf:/etc/srv/postsrsd.conf:ro
Secret=srv-srs-secret,type=mount,target=/etc/srv/postsrsd.secret,mode=0400,uid=0,gid=0
HealthCmd=nc -z -w 2 127.0.0.1 10003
HealthTimeout=5s
HealthRetries=3
HealthInterval=15s
HealthStartPeriod=90s
HealthStartupInterval=5s
HealthOnFailure=restart
LogDriver=journald
PodmanArgs=--memory=128m --log-opt=tag=postsrsd

[Service]
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=60s
TimeoutStartSec=300

[Install]
WantedBy=default.target
