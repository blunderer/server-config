DESCRIPTION="Transmission torrent client (linuxserver image)"
DEPENDS="web"
LEGACY="mytransmission"
NETWORKS="srv-web"
HEALTH_TIMEOUT=120
# Files (and folders, trailing /) that must exist; relative to data_dir.
REQUIRES="@torrent_dir@/downloads/ @torrent_dir@/in_progress/ @torrent_dir@/torrent/ users/websso/torrent.@domain@"
# Debian packages whose man pages box man installs on the host.
MANPAGES="transmission-daemon transmission-cli"
