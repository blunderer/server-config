DESCRIPTION="Tor onion service for the website"
DEPENDS="web"
LEGACY="mydarkhttpd"
VOLUMES="onion onion-state"
HEALTH_TIMEOUT=150
# Files (and folders, trailing /) that must exist; relative to data_dir.
REQUIRES="keys/tor/@onion_name@/hostname"
# Optional in the host file, but this service cannot run without it.
NEEDS="onion_name"
# Debian packages whose man pages box man installs on the host.
MANPAGES="tor"
IMAGES="localhost/srv/onion-tor=./image"
