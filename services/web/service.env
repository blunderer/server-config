DESCRIPTION="Websites: nginx, PHP-FPM, Google SSO (oauth2-proxy)"
# Not a hard dependency: PHP sites reach the database by name (mymysql).
DEPENDS="db"
LEGACY="mylighttpd"
VOLUMES="onion"
NETWORKS="srv-web srv-db"
HEALTH_TIMEOUT=90
# srv reload web: pick up renewed certificates / config / websso maps without downtime.
RELOAD="nginx:/docker-entrypoint.d/60-srv-websso-map.sh;nginx:nginx -s reload"
# Files (and folders, trailing /) that must exist; relative to data_dir.
REQUIRES="www/ www/acme/ keys/ssl/blunderer.org/fullchain.crt keys/ssl/blunderer.org/blunderer.org.key keys/websso/oauth2.cfg users/websso/"
# Debian packages whose man pages box man installs on the host.
MANPAGES="nginx nginx-common php8.4-fpm php8.4-cli"
IMAGES="localhost/srv/web-php=./image/php"
