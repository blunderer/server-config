DESCRIPTION="Authoritative DNS (BIND 9, ISC image)"
DEPENDS=""
# Containers of the old setup this service replaces (stopped on first deploy,
# restarted by srv rollback).
LEGACY="mybind"
# Volume folders under volumes_dir, shared by every release.
VOLUMES="dns-lib dns-cache"
HEALTH_TIMEOUT=120
# Debian packages whose man pages box man installs on the host.
MANPAGES="bind9 bind9-utils"
