;
; Zone file rendered by srv: the at-sign placeholders come from the host env file.
; Website records use web_ip (the host named by web= in hosts.env).
;
$TTL	300
@	IN	SOA	lelong.xyz. admin.lelong.xyz. (
			@zone_serial@	; Serial
			600		; Refresh
			600		; Retry
			1209600		; Expire
			600 )		; Negative Cache TTL
;

@ns_records@
; Certificates: only Let's Encrypt, and only through the DNS challenge
; (ssl/renew.sh). A broken-into web site cannot get one over HTTP, and no
; other authority issues for this domain.
@				IN	CAA	0 issue "letsencrypt.org; validationmethods=dns-01"
@				IN	CAA	0 issuewild "letsencrypt.org; validationmethods=dns-01"
lelong.xyz.		IN MX	@mx_first@
@mx_rest@
n.lelong.xyz.		IN MX	@mx_first@
@mx_rest@
rion.lelong.xyz.		IN MX	@mx_first@
@mx_rest@

@			IN A		@web_ip@
www			IN A		@web_ip@
home			IN A		@web_ip@
backup			IN CNAME	backup.blunderer.org.
n			IN A		@web_ip@
rion			IN A		@web_ip@

lelong.xyz.		IN TXT     	( "v=spf1 include:_spf.google.com mx@spf_extra@ -all" )
n.lelong.xyz.		IN TXT     	( "v=spf1 include:_spf.google.com mx@spf_extra@ -all" )
rion.lelong.xyz.	IN TXT     	( "v=spf1 include:_spf.google.com mx@spf_extra@ -all" )
lelong.xyz.		IN TXT     	( "google-site-verification=ieMWEfs5MWsnBOZJU7od8_z68JocCtDGL4Gp55VivhE" )
_dmarc			IN TXT		( "v=DMARC1; p=quarantine; sp=quarantine; rua=mailto:dmarc-reports@blunderer.org" )
